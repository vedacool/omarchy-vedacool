#!/usr/bin/env bash
# av-jack-notify — desktop toast when the 3.5mm headphone jack or HDMI is
# plugged/unplugged. Event-driven via `alsactl monitor` (no polling).
#
# 3.5mm  -> card0 "Headphone Jack" (numid 19)
# HDMI   -> card1 "HDMI/DP,pcm=3 Jack" (numid 1)  [HDMI audio = display present]
#
# Notifies on state CHANGE only; silent at startup.

HP_CARD=0;   HP_ID=19
HDMI_CARD=1; HDMI_ID=1

notify() {  # title  body  icon
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -u low "$1" "$2" >/dev/null 2>&1
  else
    notify-send -u low -i "${3:-audio-card}" "$1" "$2" >/dev/null 2>&1
  fi
}

jstate() {  # card  numid -> "on" | "off"
  amixer -c "$1" cget numid="$2" 2>/dev/null | grep -q 'values=on' && echo on || echo off
}

hp=$(jstate "$HP_CARD" "$HP_ID")
hdmi=$(jstate "$HDMI_CARD" "$HDMI_ID")

# Re-read on any control event; act only when a jack actually flips.
stdbuf -oL alsactl monitor 2>/dev/null | while read -r _; do
  nhp=$(jstate "$HP_CARD" "$HP_ID")
  nhdmi=$(jstate "$HDMI_CARD" "$HDMI_ID")

  if [[ $nhp != "$hp" ]]; then
    hp=$nhp
    if [[ $hp == on ]]; then notify "🎧 Headphones connected" "Output switched to headphones" audio-headphones
    else                     notify "🔊 Headphones removed" "Output back to speakers" audio-speakers; fi
  fi

  if [[ $nhdmi != "$hdmi" ]]; then
    hdmi=$nhdmi
    if [[ $hdmi == on ]]; then notify "🖥️ HDMI connected" "HDMI audio output available" video-display
    else                       notify "🖥️ HDMI disconnected" "HDMI audio output removed" video-display; fi
  fi
done
